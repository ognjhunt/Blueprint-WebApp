rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firestore ruleset for Firebase project `blueprint-8c1ca`, deployed from
// Blueprint-WebApp.
//
// The BlueprintCapture app is retired (owner, 2026-11-11): a person who works
// at the site films the job in the browser, and the WebApp client SDK reads and
// writes only `users` (and owner-scoped `scenes`). The capture app's
// client-SDK grants (capture_jobs for assigned capturers, capture_submissions,
// reservations, target_state, sessions, sessionEvents, referral codes and the
// Android telemetry collections) are removed, so those collections fall to the
// default deny. Their documents are not deleted; the Admin SDK still reads them.
//
// Admin-SDK access (Cloud Functions / server routes) BYPASSES these rules and
// needs no allow rule here. Only client-SDK (rule-governed) access is modeled.
//
// Guarded by Blueprint-WebApp/scripts/check-firestore-rules-parity.sh.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Alias kept for parity with historical WebApp rules.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('ops', false) == true
          || request.auth.token.get('role', '') in ['admin', 'ops']
          || request.auth.token.get('roles', []).hasAny(['admin', 'ops']));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStringField(field) {
      return field is string;
    }

    function hasValidScenePayload(data) {
      return isStringField(data.id)
        && isStringField(data.name)
        && isStringField(data.title)
        && isStringField(data.status)
        && isStringField(data.source)
        && isStringField(data.ownerUid)
        && (!('orgId' in data) || data.orgId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isSceneOwner() {
      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    function sceneOwnershipUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['ownerUid', 'orgId']);
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // Profile roles support onboarding only. Execution authority is assigned
    // by the Admin SDK/custom claims, never by an owner's profile write.
    function hasSafeClientProfileRoles(data) {
      return (!data.keys().hasAny(['role'])
          || data.role in ['buyer', 'creator', 'customer', 'site_operator', 'robot_team', 'guest', 'user'])
        && (!data.keys().hasAny(['roles'])
          || (data.roles is list
            && data.roles.hasOnly(['buyer', 'creator', 'customer', 'site_operator', 'robot_team', 'guest', 'user'])));
    }
    match /users/{userId} {
      allow read: if isOwner(userId);
      // structuredIntakeRequestId links an account to an inbound request and
      // is written only by the server (Admin SDK) after ownership is proven.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['admin', 'ops', 'accessRoles', 'structuredIntakeRequestId'])
        && hasSafeClientProfileRoles(request.resource.data);
      // Clients may update their own non-financial fields.
      // Financial fields (stats.availableBalance, stats.totalEarnings, etc.)
      // are written only by Cloud Functions via the Admin SDK, which bypasses
      // these rules entirely.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['stats', 'admin', 'ops', 'accessRoles', 'structuredIntakeRequestId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles'])
          || hasSafeClientProfileRoles(request.resource.data));
      // Self-service account deletion (GDPR erasure): the owner may delete
      // this document before removing the Auth user. Uploaded capture evidence
      // is retained per the capture policy and remains backend-managed.
      allow delete: if isOwner(userId);
    }

    // ─── WebApp server-owned control-plane records ─────────────────────────
    match /contactRequests/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /inboundRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;

      match /notes/{noteId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /leadRoutingConfig/{ruleId} {
      allow read, write: if isAdmin();
    }

    match /waitlistTokens/{id} {
      allow read, write: if false;
    }

    match /action_ledger/{id} {
      allow read, write: if false;
    }

    match /hostedSessions/{id} {
      allow read, write: if false;
    }

    match /operatingGraphEvents/{id} {
      allow read, write: if false;
    }

    match /operatingGraphState/{id} {
      allow read, write: if false;
    }

    match /buyerOutcomes/{id} {
      allow read, write: if false;
    }

    match /publishedMarketplaceInventory/{id} {
      allow read, write: if false;
    }

    match /humanBlockerThreads/{id} {
      allow read, write: if false;
    }

    match /humanBlockerDispatches/{id} {
      allow read, write: if false;
    }

    match /humanReplyEvents/{id} {
      allow read, write: if false;
    }

    // ─── Scenes ──────────────────────────────────────────────────────────────
    // Client-SDK scene access is owner/admin scoped. Server routes use Admin SDK.
    // (WebApp server writes go through the Admin SDK and bypass these rules.)
    match /scenes/{id} {
      allow create: if isAuthenticated()
        && hasValidScenePayload(request.resource.data)
        && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow read: if isAdmin() || isSceneOwner();
      allow update: if isAuthenticated()
        && hasValidScenePayload(request.resource.data)
        && (isAdmin() || (isSceneOwner() && sceneOwnershipUnchanged()));
      allow delete: if isAdmin() || isSceneOwner();
    }

    // ─── Default deny ────────────────────────────────────────────────────────
    // Any collection not matched above is denied to client-SDK access.
    // Admin-SDK (Cloud Functions / server routes) bypasses this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
