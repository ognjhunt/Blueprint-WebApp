# Blueprint-WebApp launch environment template
#
# Copy the keys you need into your real deployment environment.
# Do not commit real secrets to source control.
#
# This file is organized around the autonomous alpha launch gate:
# - `npm run alpha:preflight`
# - `npm run smoke:agent`

########################################
# Client build env
########################################

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional client integrations.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_APP_ID=

########################################
# Core app + Firebase Admin
########################################

NODE_ENV=production
PORT=5000
VITE_PUBLIC_APP_URL=https://www.tryblueprint.io

# Optional stable mobile handoff URL.
VITE_CAPTURE_APP_PLACEHOLDER_URL=https://www.tryblueprint.io/capture-app

# iOS app + App Clip association (served at /.well-known/apple-app-site-association).
# Unset -> 503; placeholder values -> 204. Expected bundle IDs:
# IOS_APP_BUNDLE_ID=Public.BlueprintCapture, IOS_APP_CLIP_BUNDLE_ID=Public.BlueprintCapture.Clip.
APPLE_TEAM_ID=
IOS_APP_BUNDLE_ID=
IOS_APP_CLIP_BUNDLE_ID=
# Optional comma-separated extra paths; /go, /go/* and /capture-upload/* are always included.
APP_CLIP_ADDITIONAL_PATHS=
# Numeric App Store ID of the full app. With IOS_APP_CLIP_BUNDLE_ID it turns on the
# App Clip Smart App Banner on /capture-upload/:token; unset, no banner is served.
IOS_APP_STORE_ID=

# Capture-link upload limits (optional; defaults in parentheses).
# SELF_CAPTURE_MAX_UPLOAD_BYTES=       (browser single upload, 2147483648)
# SELF_CAPTURE_MAX_PART_BYTES=         (browser chunked upload part, 33554432)
# SELF_CAPTURE_MAX_BUNDLE_FILES=       (app bundle file count, 20000)
# SELF_CAPTURE_MAX_BUNDLE_BYTES=       (app bundle total bytes, 2147483648)
# SELF_CAPTURE_MAX_BUNDLE_SIDECAR_BYTES= (app bundle bytes outside the video, 268435456)
# SELF_CAPTURE_BUNDLE_PLAN_BODY_LIMIT= (JSON body limit for the bundle plan, 8mb)

# Required for production Firebase Admin access.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIELD_ENCRYPTION_MASTER_KEY=
# Or use a KMS-wrapped data-key path instead:
FIELD_ENCRYPTION_KMS_KEY_NAME=

########################################
# Structured agent runtime
########################################

# Configure at least one provider: OpenAI, or Anthropic's own API.
# Anthropic needs only its key: leave ANTHROPIC_BASE_URL unset. Set to any host
# other than https://api.anthropic.com, Anthropic is treated as not configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ACP_HARNESS_URL=

# Optional provider selection and model overrides.
BLUEPRINT_STRUCTURED_AUTOMATION_PROVIDER=
BLUEPRINT_STRUCTURED_AUTOMATION_FALLBACK_PROVIDER=codex_local

# Per-lane provider override. `BLUEPRINT_STRUCTURED_AUTOMATION_PROVIDER` above
# moves every structured lane at once; this moves one. The key mirrors the model
# override beside it, so OPENAI_INBOUND_QUALIFICATION_MODEL picks the model and
# this picks who serves it. Requires that provider's key to be set — an unkeyed
# override falls back to the global provider rather than taking the lane
# offline, and the fall-through is reported in the agent runtime connectivity
# metadata as `unhonored_lane_providers`.
#
# The lanes that write to a person (outbound outreach, waitlist, inbound
# qualification, support, post-signup scheduling) default to OpenAI on
# gpt-6-luna whenever OPENAI_API_KEY is set; inbound qualification runs at
# reasoning effort "max". Set a lane here only to move it somewhere else.
# Leave OPENAI_DEFAULT_MODEL empty (or set it to gpt-6-luna): a stale
# gpt-5.6-luna value there overrides the code default. The follow-up picker
# ignores OPENAI_DEFAULT_MODEL and OPENAI_REASONING_EFFORT: gpt-6-luna at low
# unless OPENAI_SITE_TASK_FOLLOW_UP_MODEL or its _REASONING_EFFORT is set.
BLUEPRINT_INBOUND_QUALIFICATION_PROVIDER=openai_responses
# BLUEPRINT_WAITLIST_AUTOMATION_PROVIDER=
# BLUEPRINT_PAYOUT_EXCEPTION_PROVIDER=
# BLUEPRINT_PREVIEW_DIAGNOSIS_PROVIDER=
# BLUEPRINT_POST_SIGNUP_PROVIDER=
# BLUEPRINT_ROBOT_CAPABILITY_EXTRACTION_PROVIDER=
# BLUEPRINT_SITE_TASK_FOLLOW_UP_PROVIDER=

# Ordered providers per lane (optional): the first usable one serves the lane;
# a later one is tried once per run, and only after a provider answers "no
# funds". Entries the Privacy Policy does not permit for the lane's data are
# refused and shown in the connectivity view. The switch also applies when
# the provider was saved on a session or profile; the Privacy gate, the
# saved-provider check and the disabled-profile check run again for the second
# provider. The switch is recorded on the run (provider_failover) and in the
# action log. Example:
# BLUEPRINT_STRUCTURED_AUTOMATION_PROVIDERS=
# How long a provider that answered "no funds" is skipped when another provider
# can take the run (empty means the default, 900000 ms; 0 means no cool-down).
# A lane with nowhere else to go still asks that provider.
# BLUEPRINT_PROVIDER_NO_FUNDS_COOLDOWN_MS=

# OpenAI output ceiling and deadline. Reasoning tokens are spent out of
# max_output_tokens on the Responses API, so a lane at effort "max" needs
# headroom. Defaults are 16000 tokens and 120000 ms; both
# are ceilings, not reservations.
# BLUEPRINT_OPENAI_AGENT_MAX_OUTPUT_TOKENS=
# OPENAI_TIMEOUT_MS=
# Preflight mode:
# - strict: production/default behavior, waivers ignored
# - local_test: allow explicit waivers for local testing
BLUEPRINT_ALPHA_PREFLIGHT_MODE=strict
# Local testing only: waive specific preflight requirements without faking creds.
# Supported values: post_signup, research_outbound
BLUEPRINT_ALPHA_PREFLIGHT_WAIVERS=
CODEX_DEFAULT_MODEL=
OPENAI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
ACP_DEFAULT_HARNESS=

########################################
# Pipeline + internal marketplace
########################################

PIPELINE_SYNC_TOKEN=
# Company policy container admission is metadata-only and no-spend. Production
# must configure an exact Pipeline intake URL, an exact registry-host allowlist,
# a KMS key, separate fingerprint/broker secrets, and the autonomous outbox.
COMPANY_POLICY_CONTAINER_FORWARD_URL=
COMPANY_POLICY_CONTAINER_FORWARD_CLIENT_ID=blueprint-webapp
COMPANY_POLICY_CONTAINER_FORWARD_REQUIRED=true
COMPANY_POLICY_ALLOWED_REGISTRIES=
COMPANY_POLICY_CREDENTIAL_FINGERPRINT_KEY=
COMPANY_POLICY_CREDENTIAL_BROKER_TOKEN=
COMPANY_POLICY_CREDENTIAL_BROKER_CLIENT_ID=blueprint-policy-sandbox-worker
COMPANY_POLICY_CREDENTIAL_BROKER_MAX_SKEW_MS=60000
BLUEPRINT_COMPANY_POLICY_OUTBOX_WORKER_ENABLED=true
COMPANY_POLICY_OUTBOX_WORKER_INTERVAL_MS=30000
COMPANY_POLICY_OUTBOX_MAX_ATTEMPTS=12
COMPANY_POLICY_OUTBOX_RETRY_BASE_MS=30000
# Launch-only production runner credential. Configure the same random 32-byte
# or longer secret in the Web service and the host-resident production runner.
# It cannot read admin state or release terminal resources.
BLUEPRINT_TASK_EVALUATION_LAUNCH_SUBMIT_SECRET=
BLUEPRINT_TASK_EVALUATION_LAUNCH_SUBMIT_MAX_CLOCK_SKEW_MS=300000
BLUEPRINT_TASK_EVALUATION_LAUNCH_SUBMIT_RATE_LIMIT_WINDOW_MS=300000
BLUEPRINT_TASK_EVALUATION_LAUNCH_SUBMIT_RATE_LIMIT_MAX=30
BLUEPRINT_REQUEST_REVIEW_TOKEN_SECRET=
# Signed transfer of a completed private B2 capture into Pipeline. WebApp sends
# a short-lived, object-prefix-scoped download grant; neither service persists it.
CAPTURE_UPLOAD_INTAKE_FORWARD_URL=
CAPTURE_UPLOAD_INTAKE_FORWARD_TOKEN=
CAPTURE_UPLOAD_INTAKE_FORWARD_CLIENT_ID=blueprint-webapp
CAPTURE_UPLOAD_INTAKE_FORWARD_REQUIRED=true
CAPTURE_UPLOAD_INTAKE_FORWARD_TIMEOUT_MS=600000
# Optional explicit Pipeline API base (for example, ending in
# /api/live-pipeline). When omitted, WebApp derives it by removing the final
# /capture-upload-intakes segment from CAPTURE_UPLOAD_INTAKE_FORWARD_URL.
CAPTURE_LIFECYCLE_PIPELINE_BASE_URL=
CAPTURE_LIFECYCLE_FORWARD_TIMEOUT_MS=10000
# Optional reconstruction overrides. By default this control path reuses the
# capture lifecycle/API base and HMAC identity above.
RECONSTRUCTION_PIPELINE_BASE_URL=
RECONSTRUCTION_FORWARD_TOKEN=
RECONSTRUCTION_FORWARD_CLIENT_ID=blueprint-webapp
RECONSTRUCTION_FORWARD_TIMEOUT_MS=60000
# Signed, server-to-server Task Evaluation Run control endpoints. WebApp never
# sends method profiles or qualification records; Pipeline owns that catalog.
TASK_EVALUATION_RUN_PLAN_URL=
TASK_EVALUATION_RUN_AUTHORIZE_URL=
TASK_EVALUATION_RUN_EXECUTE_URL=
TASK_EVALUATION_RESULT_ARTIFACT_URL_TEMPLATE=
TASK_EVALUATION_RESULT_DOWNLOAD_SIGNING_SECRET=
TASK_EVALUATION_RUN_FORWARD_TOKEN=
TASK_EVALUATION_RUN_FORWARD_CLIENT_ID=blueprint-webapp
TASK_EVALUATION_RUN_FORWARD_REQUIRED=true
TASK_EVALUATION_RUN_FORWARD_TIMEOUT_MS=10000
ROBOT_EVAL_JOB_REQUEST_FORWARD_URL=
# HMAC secret for signed Pipeline intake requests; do not send as bearer auth.
ROBOT_EVAL_JOB_REQUEST_FORWARD_TOKEN=
ROBOT_EVAL_JOB_REQUEST_FORWARD_REQUIRED=true
ROBOT_EVAL_JOB_REQUEST_FORWARD_TIMEOUT_MS=10000
ROBOT_EVAL_JOB_REQUEST_FORWARD_CAPTURE_ROOT=
ROBOT_EVAL_JOB_REQUEST_FORWARD_CAPTURE_ROOT_BY_SITE_JSON=

########################################
# Autonomous alpha lane enables
########################################

BLUEPRINT_WAITLIST_AUTOMATION_ENABLED=1
BLUEPRINT_INBOUND_AUTOMATION_ENABLED=1
BLUEPRINT_SUPPORT_TRIAGE_ENABLED=1
BLUEPRINT_PAYOUT_TRIAGE_ENABLED=1
BLUEPRINT_PREVIEW_DIAGNOSIS_ENABLED=1
BLUEPRINT_EXPERIMENT_AUTOROLLOUT_ENABLED=1
BLUEPRINT_AUTONOMOUS_RESEARCH_OUTBOUND_ENABLED=1
BLUEPRINT_CREATIVE_FACTORY_ENABLED=1
BLUEPRINT_BUYER_LIFECYCLE_ENABLED=1

# Beta cohort admission controls for capturer signup and native capture intake.
BLUEPRINT_BETA_ENABLED=true
BLUEPRINT_BETA_KILL_SWITCH=0
BLUEPRINT_BETA_INVITE_CAP=100
BLUEPRINT_BETA_COHORT_DAILY_LIMIT=25
BLUEPRINT_BETA_ALLOWED_MARKETS=
BLUEPRINT_BETA_ALLOWED_SITE_TYPES=
BLUEPRINT_BETA_DEFAULT_COHORT=default

# Optional watchdogs.

########################################
# Gap closure registry (detect → delegate → escalate → auto-resolve)
########################################
#
# When enabled, periodically merges launch-readiness blockers + automation worker failures
# into Firestore `opsWorkItems`, notifies Slack (and optional webhook), escalates stale rows,
# and auto-completes items when readiness/worker signals clear. External gaps (CI, manual)
# post to /api/internal/gap-intake/report with X-Blueprint-Gap-Token.
#
# Default worker cadence is 15 minutes in code; override in ms if needed.

# Optional: receives { event: "gap.delegated" | "gap.escalated", ... } JSON payloads.

########################################
# Post-signup automation
########################################

# Required unless you reuse FIREBASE_SERVICE_ACCOUNT_JSON / GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
POST_SIGNUP_SPREADSHEET_ID=
# Alternative legacy sheet key:
# SPREADSHEET_ID=

SLACK_WEBHOOK_URL=

########################################
# Email delivery
########################################

# Sole application email delivery path. Use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Blueprint
RESEND_WEBHOOK_SECRET=

# Human blocker reply ingest and mailbox watcher.
BLUEPRINT_HUMAN_REPLY_APPROVED_EMAIL=ohstnhunt@gmail.com
# Manual mirror of the Google OAuth consent-screen publishing state.
# Allowed values: testing, production. Leave unset to fail closed as unknown.
# Slack reply watching is resumable only for surfaces the bot can actually see.
# Enable DMs and/or list allowed channel ids for thread replies.
# Optional overrides:

# Operating graph projection from first-party evidence collections.
# Optional overrides:

########################################
# Growth event ingest + experiment rollout
########################################

BLUEPRINT_ANALYTICS_INGEST_ENABLED=1
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
VITE_GA_MEASUREMENT_ID=

########################################
# Autonomous research outbound
########################################

FIREHOSE_API_TOKEN=
FIREHOSE_BASE_URL=
BLUEPRINT_AUTONOMOUS_RESEARCH_TOPICS=robot-teams,site-operators,capturer-supply

# Autonomous research email uses the same Resend sender.
BLUEPRINT_AUTONOMOUS_OUTBOUND_CHANNEL=resend
BLUEPRINT_AUTONOMOUS_OUTBOUND_RECIPIENTS=

########################################
# Buyer lifecycle + voice concierge
########################################

BLUEPRINT_VOICE_BOOKING_URL=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BLUEPRINT_VOICE_FORWARD_NUMBER=

########################################
# Hosted sessions, rate limiting, and monitoring
########################################

REDIS_URL=
RATE_LIMIT_REDIS_URL=

VITE_SENTRY_DSN=
VITE_ENABLE_ERROR_TRACKING_SMOKE_TEST=false

########################################
# Paperclip relays from Blueprint-WebApp to the local/shared hub
########################################


########################################
# Notion sync
########################################

NOTION_API_KEY=

########################################
# Paperclip model fallback config (Hermes, Codex for coding)
########################################

# The Hermes lane's provider and models are the owner's to choose; the
# removed endpoint and models are no longer used.
# The Paperclip scripts are not changed here and still default elsewhere: with
# BLUEPRINT_PAPERCLIP_HERMES_BASE_URL empty, quota-fallback.ts and
# reconcile-blueprint-paperclip-company.sh fill in DeepSeek's endpoint and
# models. Leaving it empty does NOT give Anthropic's own API. Until those
# defaults are changed, set it to https://api.anthropic.com, or do not run the
# Hermes lane.
BLUEPRINT_PAPERCLIP_HERMES_PROVIDER=anthropic
BLUEPRINT_PAPERCLIP_HERMES_BASE_URL=
BLUEPRINT_PAPERCLIP_HERMES_PRIMARY_MODEL=

# Fallback ladder for Hermes when primary hits quota (tried in order).
BLUEPRINT_PAPERCLIP_HERMES_FALLBACK_MODEL=
BLUEPRINT_PAPERCLIP_HERMES_FALLBACK_MODELS=

# Phase 2 action execution (enable waitlist lane for autonomous execution)
# BLUEPRINT_PHASE2_WAITLIST_ENABLED=1
