{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "email:account-notice": "tsx scripts/email/account-notice.ts",
    "dev": "tsx watch --clear-screen=false --exclude vite.config.ts.* server/index.ts",
    "build": "node scripts/verify-client-env.mjs && vite build && tsx --tsconfig tsconfig.prerender.json scripts/prerender.tsx && tsx scripts/generate-sitemap.ts && node scripts/generate-build-info.mjs && npx esbuild server/index.ts server/worker.ts server/agents/communications-gmail.ts server/research-learning/research-worker-host.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/prepare-daily-research.mjs",
    "render:proof-reel": "npm exec --package=@remotion/cli@4.0.438 remotion render proof-reel/index.ts BlueprintProofReel client/public/proof/blueprint-proof-reel.mp4 --public-dir client/public",
    "render:site-motion-loop": "mkdir -p tmp/remotion && npm exec --package=@remotion/cli@4.0.438 -- remotion render proof-reel/index.ts BlueprintSiteMotionLoop --output tmp/remotion/blueprint-site-motion-loop.raw.mp4 --public-dir client/public && npm exec --package=@remotion/cli@4.0.438 -- remotion ffmpeg -y -i tmp/remotion/blueprint-site-motion-loop.raw.mp4 -an -c:v libx264 -preset medium -crf 28 -movflags +faststart client/public/proof/blueprint-site-motion-loop.mp4 && rm tmp/remotion/blueprint-site-motion-loop.raw.mp4",
    "render:site-motion-loop:poster": "npm exec --package=@remotion/cli@4.0.438 -- remotion still proof-reel/index.ts BlueprintSiteMotionLoop --output client/public/proof/blueprint-site-motion-loop-poster.png --frame=42 --public-dir client/public",
    "start": "NODE_ENV=production node dist/index.js",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "stripe:reconcile": "tsx scripts/stripe-ledger-reconcile.ts",
    "check": "tsc -p tsconfig.full.json --noEmit",
    "rules:firestore-parity": "bash scripts/check-firestore-rules-parity.sh",
    "rules:storage-parity": "bash scripts/check-storage-rules-parity.sh",
    "rules:parity": "npm run rules:firestore-parity && npm run rules:storage-parity",
    "perf:pages": "tsx scripts/measure-page-load-performance.ts",
    "smoke:agent": "tsx scripts/agent-runtime-smoke.ts",
    "agent:routing": "tsx scripts/agent-lane-routing.ts",
    "agent:cost-cache-report": "tsx scripts/agent-cache-cost-report.ts",
    "smoke:openclaw": "tsx scripts/agent-runtime-smoke.ts",
    "pipeline:forwarding:preflight": "tsx scripts/pipeline/audit-robot-eval-forwarding-readiness.ts",
    "pipeline:robot-eval-contract:verify": "bash scripts/pipeline/verify-contracts.sh",
    "pipeline:decision-evidence-contract:verify": "tsx scripts/pipeline/verify-decision-evidence-router-contract.ts",
    "pipeline:capture-intake-contract:verify": "tsx scripts/pipeline/verify-capture-intake-contract.ts",
    "pipeline:task-candidate-contract:verify": "tsx scripts/pipeline/verify-task-candidate-contract.ts",
    "pipeline:testbed-compilation-contract:verify": "tsx scripts/pipeline/verify-testbed-compilation-contract.ts",
    "pipeline:site-task-measurement-catalog:verify": "tsx scripts/pipeline/verify-site-task-measurement-catalog.ts",
    "pipeline:robot-spec-catalog:verify": "tsx scripts/pipeline/verify-robot-spec-catalog.ts",
    "smoke:launch": "node scripts/launch-smoke.mjs",
    "smoke:launch:local": "node scripts/launch-smoke-local.mjs",
    "deploy:rollback": "node scripts/deploy-rollback.mjs",
    "doctrine:verify": "tsx scripts/doctrine/verify-shared-doctrine.ts",
    "test": "vitest run",
    "test:site-reliability:browser": "playwright test --config playwright.site-reliability.config.ts",
    "test:answer-journey:browser": "playwright test --config playwright.answer-journey.config.ts",
    "test:workspace:browser": "playwright test --config playwright.workspace.config.ts",
    "test:rules": "npx -y firebase-tools@13.35.1 emulators:exec --only firestore,storage --project blueprint-rules-test \"npx vitest run --config vitest.rules.config.ts\"",
    "human-replies:poll": "tsx scripts/human-replies/poll-gmail-replies.ts",
    "human-replies:audit-gmail": "tsx scripts/human-replies/audit-gmail-oauth.ts",
    "human-replies:audit-durability": "tsx scripts/human-replies/audit-outbound-reply-durability.ts",
    "human-replies:prove-production": "tsx scripts/human-replies/prove-production-resume.ts",
    "human-replies:send-test-blocker": "tsx scripts/human-replies/send-test-blocker.ts",
    "operating-graph:project": "tsx scripts/autonomy/project-operating-graph.ts --limit=500",
    "autonomy:kpi-source-status": "tsx scripts/autonomy/generate-kpi-source-status.ts",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "qa:operator": "tsx scripts/qa/run-operator-surfaces.ts",
    "notion-grounding:refresh": "tsx scripts/gemini/refresh-notion-grounding.ts",
    "test:coverage": "vitest run --coverage --exclude client/tests/build-output.test.ts",
    "test:build-output": "vitest run client/tests/build-output.test.ts",
    "test:e2e": "playwright test && tsx scripts/qa/run-task-evaluation-run-e2e.ts",
    "alpha:check": "node scripts/alpha-check.mjs",
    "alpha:preflight": "node scripts/launch-preflight.mjs",
    "alpha:env": "node scripts/launch-env-audit.mjs",
    "claims:guard": "tsx scripts/claims/cross-source-claims-guard.ts",
    "render:import-env": "node scripts/render/import-render-env.mjs",
    "test:result-consumer:browser": "playwright test --config playwright.result-consumer.config.ts",
    "assessment:iterate": "tsx scripts/site-assessment-iterate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google-cloud/kms": "^5.2.1",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@notionhq/client": "^5.16.0",
    "@openai/agents": "0.3.9",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@remotion/bundler": "^4.0.438",
    "@remotion/renderer": "^4.0.438",
    "@sentry/react": "^10.34.0",
    "@tanstack/react-query": "^5.60.5",
    "backblaze-b2": "^1.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "5.3.0",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^11.18.2",
    "gaxios": "^6.7.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.453.0",
    "multer": "^2.5.0",
    "node-fetch": "^3.3.2",
    "openai": "6.49.0",
    "parse5": "7.3.0",
    "pino": "^9.9.5",
    "pngjs": "^5.0.0",
    "posthog-js": "^1.364.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "redis": "^5.10.0",
    "remotion": "^4.0.438",
    "resend": "^6.28.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.5.4",
    "validator": "^13.15.26",
    "wouter": "^3.3.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "fast-uri": "4.2.3",
    "google-gax": {
      "@grpc/grpc-js": "1.14.5"
    },
    "qs": "6.16.0",
    "rimraf": "6.1.3",
    "uuid": "11.1.1",
    "zod": "$zod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "4.17.21",
    "@types/google.maps": "^3.58.1",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^3.1.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.3.0",
    "jsdom": "^26.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^3.1.4"
  }
}
