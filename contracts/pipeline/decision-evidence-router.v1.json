{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/pipeline/decision-evidence-router.v1.json",
  "title": "Blueprint Decision/Evidence Router WebApp handoff",
  "description": "Proposed WebApp mirror of the Pipeline-owned Decision/Evidence Router handoff. BlueprintCapturePipeline remains authoritative for routing, method qualification, evidence normalization, and scientific verdicts.",
  "contract_status": "proposed_dependency_unmerged",
  "authority": "BlueprintCapturePipeline",
  "consumer": "Blueprint-WebApp",
  "provenance": {
    "source_repo": "BlueprintCapturePipeline",
    "expected_source_path": "contracts/decision_evidence_router/decision-evidence-router.v1.json",
    "source_ref_at_import": null,
    "imported_from_merged_pipeline": false,
    "webapp_must_not_claim_live_cross_repo_compatibility": true
  },
  "schema_versions": {
    "site_task_testbed_manifest": "blueprint.site_task_testbed_manifest.v1",
    "decision_evidence_request": "blueprint.decision_evidence_request.v1",
    "evidence_plan": "blueprint.evidence_plan.v1",
    "evidence_method_profile": "blueprint.evidence_method_profile.v1",
    "normalized_evidence_result": "blueprint.normalized_evidence_result.v1",
    "decision_envelope": "blueprint.decision_envelope.v1",
    "physical_outcome_join": "blueprint.physical_outcome_join.v1"
  },
  "run_states": [
    "draft",
    "submitted",
    "accepted",
    "planning",
    "awaiting_authorization",
    "running",
    "aggregating",
    "decision_available",
    "abstained",
    "blocked",
    "failed",
    "superseded"
  ],
  "decision_outcomes": [
    "bounded_positive",
    "bounded_negative",
    "partial",
    "abstained",
    "blocked",
    "failed"
  ],
  "claim_outcomes": [
    "supported",
    "not_supported",
    "inconclusive",
    "unsupported"
  ],
  "evidence_classes": [
    "fixture",
    "geometry",
    "real_observation",
    "traditional_simulation",
    "world_model",
    "provider_tool",
    "physical"
  ],
  "request_required_fields": [
    "schema_version",
    "request_id",
    "decision_id",
    "testbed",
    "decision_question",
    "site_task",
    "claims",
    "thresholds",
    "false_safe",
    "confidence_requirement",
    "constraints",
    "requested_audience",
    "routing_authority",
    "idempotency",
    "provenance",
    "owner",
    "commercial"
  ],
  "result_required_fields": [
    "schema_version",
    "request_id",
    "decision_id",
    "state",
    "requested_decision",
    "testbed",
    "overall",
    "claim_outcomes",
    "evidence_methods",
    "validation_envelope",
    "coverage",
    "uncertainty",
    "disagreements",
    "claim_ceiling",
    "next_cheapest_experiment",
    "physical_evidence",
    "artifacts",
    "permitted_evidence_uses",
    "provenance"
  ],
  "physical_outcome_join_required_fields": [
    "schema_version",
    "join_id",
    "request_id",
    "decision_id",
    "testbed",
    "physical_artifact",
    "observed_claim_ids",
    "outcome_summary",
    "authoritative_source",
    "method_recalibration_allowed"
  ],
  "invariants": {
    "routing_authority": "BlueprintCapturePipeline",
    "webapp_selects_backend": false,
    "normal_request_contains_simulator_preference": false,
    "unknown_state_fails_closed": true,
    "abstention_must_not_infer_winner": true,
    "artifact_reference_requires_version_and_sha256": true,
    "post_training_is_evidence_use_not_product": true,
    "client_supplied_price_allowed": false,
    "raw_policy_weights_allowed": false,
    "user_note_alone_can_recalibrate_method": false,
    "client_secrets_allowed": false
  }
}
